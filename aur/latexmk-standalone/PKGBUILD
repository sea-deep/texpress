# Maintainer: Dipak <dipak@texpress>
pkgname=latexmk-standalone
pkgver=4.88
pkgrel=1
pkgdesc="Perl script for running LaTeX, pdflatex, tectonic, XeLaTeX, LuaLaTeX (standalone without TeX Live dependency)"
arch=('any')
url="https://ctan.org/pkg/latexmk"
license=('GPL2')
depends=('perl')
optdepends=(
  'tectonic: lightweight rust TeX engine with on-demand package downloading'
  'texlive-binextra: full TeX Live engines'
)
provides=('latexmk')
conflicts=('latexmk' 'texlive-binextra')
source=("https://mirrors.ctan.org/support/latexmk.zip")
sha256sums=('6eb1b9c1f12518a1d6e23792d30bed4f43e8fae1b9c30b0e7d54a0e19e027c28')

package() {
  cd "$srcdir/latexmk"
  install -Dm755 latexmk.pl "$pkgdir/usr/bin/latexmk"
  install -Dm644 latexmk.1 "$pkgdir/usr/share/man/man1/latexmk.1"
  install -Dm644 README "$pkgdir/usr/share/doc/$pkgname/README"
}
